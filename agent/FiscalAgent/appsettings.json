{
  "Agent": {
    "AgentId": "00000000-0000-0000-0000-000000000000",
    "RestaurantId": "00000000-0000-0000-0000-000000000000",
    "DatabasePath": "data/fiscalagent.db",

    "Fiscal": {
      "Driver": "FiscalNet",
      "BaseUrl": "http://localhost:65400",
      "TimeoutSeconds": 60,
      "FakeOutputDir": "data/fake-receipts"
    },

    "Backend": {
      "Enabled": false,
      "BaseUrl": "https://api.example.com",
      "Token": "",
      "StreamPath": "/agent/stream",
      "ResultPath": "/agent/jobs/{jobId}/result",
      "ReconnectDelaySeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
